<Window x:Class="DuneEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="560" Width="800" MinWidth="500" MinHeight="350" xmlns:my="clr-namespace:DuneEdit">
    <Window.Resources>
        <BitmapImage x:Key="Arrakeen" UriSource="Res/Arrakeen.png"/>
        <BitmapImage x:Key="Carthag"  UriSource="Res/Carthag.png"/>
        <BitmapImage x:Key="Fort"     UriSource="Res/Fort.png"/>
        <BitmapImage x:Key="Sietch"   UriSource="Res/Sietch.png"/>
        <BitmapImage x:Key="Village"  UriSource="Res/Village.png"/>
        <BitmapImage x:Key="Unknown"  UriSource="Res/Unknown.png"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"    Name="MapColumn" />
            <ColumnDefinition Width="Auto" Name="SplitterColumn" />
            <ColumnDefinition Width="0"    Name="DetailsColumn" />
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0" Grid.ColumnSpan="3" Height="23" Name="menu1" VerticalAlignment="Top">
            <MenuItem Header="File">
                <MenuItem Command="ApplicationCommands.Open" Header="Open" />
                <MenuItem Command="ApplicationCommands.Save" Header="Save" />
                <MenuItem Command="ApplicationCommands.SaveAs" Header="Save As.." />
                <MenuItem Header="Test" Click="TestClick" />
            </MenuItem>
        </Menu>
        <Canvas Grid.Row="1" Grid.Column="0"  Height="Auto" HorizontalAlignment="Stretch" Name="map" VerticalAlignment="Stretch" Background="#FFFFF755" SizeChanged="map_SizeChanged"></Canvas>
        <GridSplitter Grid.Row="1" Grid.Column="1" Name="Splitter" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="3" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
        <Grid Grid.Row="1" Grid.Column="2" Name="detailsPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Name="btnHideDetails" Width="16" Content="⇇" FontFamily="Arial Unicode MS" Click="btnHideDetails_Click" />
            <ScrollViewer Grid.Column="1" Name="detailsPanelScroll">
                <Frame Name="detailsPanelFrame" />
            </ScrollViewer>
        </Grid>
    </Grid>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCmdExecuted" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCmdExecuted" />
    </Window.CommandBindings>
</Window>
