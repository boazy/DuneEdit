<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DuneEdit.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="DuneEdit.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        Icon="/Assets/Locations/Sietch.png"
        Title="Dune Editor">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <LinearGradientBrush x:Key="ArrakisSandFieldBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FFE681" />
      <GradientStop Offset="0.48" Color="#F1C452" />
      <GradientStop Offset="1" Color="#C67A2A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ErgShadowBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#7D3616" />
      <GradientStop Offset="1" Color="#A84E1B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DuneCrestBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="#FFEFA7" />
      <GradientStop Offset="1" Color="#F4C750" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MapLabelBrush" Color="#703718" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.marker">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.marker:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.marker-frame">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.marker-frame.selected">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
      <Setter Property="BoxShadow" Value="0 3 10 2 #9A451A08" />
    </Style>
    <Style Selector="TextBlock.location-name">
      <Setter Property="Foreground" Value="{StaticResource WaterBrush}" />
    </Style>
    <Style Selector="TextBlock.location-name.atreides">
      <Setter Property="Foreground" Value="{StaticResource AtreidesBrush}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Expander.detail-group">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="22,15"
            Background="#241B13"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DUNE EDITOR"
                     FontSize="22"
                     FontWeight="Black"
                     LetterSpacing="2.6"
                     Foreground="{StaticResource GoldBrush}" />
          <TextBlock Text="Save-game cartography"
                     Margin="0,2,0,0"
                     FontSize="11"
                     LetterSpacing="0.8"
                     Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="28,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentFileName}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource BodyBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusText}"
                     Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="{StaticResource MutedBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button Grid.Column="2"
                Classes="action"
                Content="Open file"
                Command="{Binding OpenCommand}" />
        <Button Grid.Column="3"
                Classes="action"
                Content="Save changes"
                Command="{Binding SaveCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Border Margin="18"
              CornerRadius="5"
              ClipToBounds="True"
              BorderBrush="#6C5130"
              BorderThickness="1"
              Background="{StaticResource ArrakisSandFieldBrush}">

        <Grid>
          <Viewbox Stretch="Uniform">
            <Canvas Width="1000" Height="620">
              <Rectangle Width="1000"
                         Height="620"
                         Fill="{StaticResource ArrakisSandFieldBrush}" />

              <Path Data="M -80,118 C 95,46 244,87 391,35 C 552,-21 689,50 842,17 C 930,-2 1016,28 1080,77 L 1080,165 C 921,105 798,151 663,135 C 489,115 371,159 220,142 C 101,129 11,166 -80,222 Z"
                    Fill="{StaticResource ErgShadowBrush}"
                    Opacity="0.30" />
              <Path Data="M -60,364 C 84,289 191,334 316,282 C 449,226 586,283 709,218 C 823,159 959,210 1065,164 L 1065,263 C 936,315 819,291 700,348 C 561,415 425,353 303,404 C 155,466 49,413 -60,481 Z"
                    Fill="{StaticResource ErgShadowBrush}"
                    Opacity="0.38" />
              <Path Data="M -25,161 C 145,91 255,135 394,83 C 540,28 690,93 846,54 C 933,32 1008,54 1037,77"
                    Stroke="{StaticResource DuneCrestBrush}"
                    StrokeThickness="13"
                    StrokeLineCap="Round"
                    Opacity="0.70" />
              <Path Data="M -40,432 C 96,358 199,401 318,349 C 447,293 584,347 705,286 C 824,226 932,275 1054,221"
                    Stroke="{StaticResource DuneCrestBrush}"
                    StrokeThickness="11"
                    StrokeLineCap="Round"
                    Opacity="0.66" />
              <Path Data="M 67,560 C 174,508 278,547 373,510 C 494,463 596,515 707,474 C 832,427 903,469 1003,432"
                    Stroke="{StaticResource ErgShadowBrush}"
                    StrokeThickness="7"
                    StrokeLineCap="Round"
                    Opacity="0.28" />

              <TextBlock Canvas.Left="22"
                         Canvas.Top="18"
                         Text="ARRAKIS LOCATION PLOT"
                         FontSize="11"
                         FontWeight="Bold"
                         LetterSpacing="1.7"
                         Foreground="{StaticResource MapLabelBrush}"
                         Opacity="0.72" />

              <ItemsControl Width="1000"
                            Height="620"
                            ItemsSource="{Binding Locations}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{ReflectionBinding Left}" />
                    <Setter Property="Canvas.Top" Value="{ReflectionBinding Top}" />
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocationMarkerViewModel">
                    <Button Classes="marker"
                            Width="{Binding Width}"
                            Height="{Binding Height}"
                            MinWidth="0"
                            MinHeight="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Command="{Binding SelectCommand}"
                            ToolTip.Tip="{Binding Name}">
                      <Grid Width="{Binding Width}"
                            Height="{Binding Height}"
                            RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                          <ScaleTransform ScaleX="{Binding SelectionScale}"
                                          ScaleY="{Binding SelectionScale}" />
                        </Grid.RenderTransform>
                        <Image Source="{Binding Image}"
                               Width="{Binding Width}"
                               Height="{Binding Height}"
                               Stretch="Uniform" />
                        <Border Classes="marker-frame"
                                Classes.selected="{Binding IsSelected}"
                                IsHitTestVisible="False" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </Viewbox>

          <Border IsVisible="{Binding HasNoDocument}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="32,26"
                  CornerRadius="4"
                  Background="#DB201A15"
                  BorderBrush="#8F6941"
                  BorderThickness="1">
            <StackPanel MaxWidth="340" Spacing="8">
              <TextBlock Text="Chart a saved Arrakis"
                         HorizontalAlignment="Center"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource GoldBrush}" />
              <TextBlock Text="Open a Dune save or game executable to inspect its palaces, villages, forts, and sietches."
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         LineHeight="21"
                         Foreground="{StaticResource BodyBrush}" />
              <Button Classes="action"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Center"
                      Content="Open Dune file"
                      Command="{Binding OpenCommand}" />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding IsBusy}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="16"
                  Padding="14,10"
                  CornerRadius="3"
                  Background="#E6241B13">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ProgressBar Width="58" IsIndeterminate="True" />
              <TextBlock Text="Working…" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              IsVisible="{Binding HasSelection}"
              Width="356"
              Background="{StaticResource UmberBrush}"
              BorderBrush="{StaticResource HairlineBrush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="24,20"
                  Background="#332519"
                  BorderBrush="{StaticResource HairlineBrush}"
                  BorderThickness="0,0,0,1">
            <StackPanel>
              <TextBlock Text="{Binding SelectedLocation.Type}"
                         Classes="section-title" />
              <TextBlock Text="{Binding SelectedLocation.Name}"
                         Classes="location-name"
                         Classes.atreides="{Binding SelectedLocation.IsAtreidesControlled}"
                         Margin="0,5,0,0"
                         FontSize="21"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,20,24,30">
              <TextBlock Text="RESOURCES" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding SelectedLocation.Resources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NumericFieldViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                      <TextBlock Text="{Binding Label}"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource BodyBrush}" />
                      <NumericUpDown Grid.Column="1"
                                     Minimum="0"
                                     Maximum="255"
                                     Increment="1"
                                     FormatString="0"
                                     Value="{Binding Value, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Margin="0,18" Background="{StaticResource HairlineBrush}" />
              <TextBlock Text="CONDITIONS" Classes="section-title" />
              <ItemsControl Margin="0,5,0,0"
                            ItemsSource="{Binding SelectedLocation.Conditions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BooleanFieldViewModel">
                    <CheckBox Margin="0,4"
                              Content="{Binding Label}"
                              IsChecked="{Binding Value, Mode=TwoWay}"
                              Foreground="{StaticResource BodyBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Expander Classes="detail-group" Header="Advanced fields">
                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding SelectedLocation.Advanced}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumericFieldViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BodyBrush}" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="255"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>

              <Expander Classes="detail-group" Header="Unknown fields">
                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding SelectedLocation.Unknown}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumericFieldViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="255"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="18,7"
            Background="#20170F"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1"
                   Text="0–255 values · save writes in place"
                   FontSize="11"
                   Foreground="#7E6D5B" />
      </Grid>
    </Border>
  </Grid>
</Window>
