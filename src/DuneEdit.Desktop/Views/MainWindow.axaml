<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DuneEdit.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="DuneEdit.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        Icon="/Assets/Locations/Sietch.png"
        Title="Dune Editor">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Button.marker">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.marker:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.marker-frame">
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.marker-frame.selected">
      <Setter Property="Background" Value="#66311D0B" />
      <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Expander.detail-group">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="22,15"
            Background="#241B13"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DUNE EDITOR"
                     FontSize="22"
                     FontWeight="Black"
                     LetterSpacing="2.6"
                     Foreground="{StaticResource GoldBrush}" />
          <TextBlock Text="Save-game cartography"
                     Margin="0,2,0,0"
                     FontSize="11"
                     LetterSpacing="0.8"
                     Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="28,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentFileName}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource BodyBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding StatusText}"
                     Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="{StaticResource MutedBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button Grid.Column="2"
                Classes="action"
                Content="Open file"
                Command="{Binding OpenCommand}" />
        <Button Grid.Column="3"
                Classes="action"
                Content="Save changes"
                Command="{Binding SaveCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Border Margin="18"
              CornerRadius="5"
              ClipToBounds="True"
              BorderBrush="#6C5130"
              BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#DCC177" />
            <GradientStop Offset="0.46" Color="#CDA457" />
            <GradientStop Offset="1" Color="#A86F35" />
          </LinearGradientBrush>
        </Border.Background>

        <Grid>
          <Viewbox Stretch="Uniform">
            <Canvas Width="1000" Height="620">
              <Line StartPoint="100,0" EndPoint="100,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="200,0" EndPoint="200,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="300,0" EndPoint="300,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="400,0" EndPoint="400,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="500,0" EndPoint="500,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="600,0" EndPoint="600,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="700,0" EndPoint="700,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="800,0" EndPoint="800,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="900,0" EndPoint="900,620" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="0,100" EndPoint="1000,100" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="0,200" EndPoint="1000,200" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="0,300" EndPoint="1000,300" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="0,400" EndPoint="1000,400" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="0,500" EndPoint="1000,500" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />
              <Line StartPoint="0,600" EndPoint="1000,600" Stroke="#2B241C" StrokeThickness="1" Opacity="0.10" />

              <TextBlock Canvas.Left="22"
                         Canvas.Top="18"
                         Text="ARRAKIS LOCATION PLOT"
                         FontSize="11"
                         FontWeight="Bold"
                         LetterSpacing="1.7"
                         Foreground="#7A4B22"
                         Opacity="0.72" />

              <ItemsControl Width="1000"
                            Height="620"
                            ItemsSource="{Binding Locations}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                  <Style Selector="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{ReflectionBinding Left}" />
                    <Setter Property="Canvas.Top" Value="{ReflectionBinding Top}" />
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocationMarkerViewModel">
                    <Button Classes="marker"
                            Command="{Binding SelectCommand}"
                            ToolTip.Tip="{Binding Name}"
                            RenderTransformOrigin="0.5,0.5">
                      <Button.RenderTransform>
                        <ScaleTransform ScaleX="{Binding SelectionScale}"
                                        ScaleY="{Binding SelectionScale}" />
                      </Button.RenderTransform>
                      <Border Classes="marker-frame"
                              Classes.selected="{Binding IsSelected}">
                        <Image Source="{Binding Image}"
                               Width="{Binding Width}"
                               Height="{Binding Height}"
                               Stretch="Uniform" />
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </Viewbox>

          <Border IsVisible="{Binding HasNoDocument}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="32,26"
                  CornerRadius="4"
                  Background="#DB201A15"
                  BorderBrush="#8F6941"
                  BorderThickness="1">
            <StackPanel MaxWidth="340" Spacing="8">
              <TextBlock Text="Chart a saved Arrakis"
                         HorizontalAlignment="Center"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource GoldBrush}" />
              <TextBlock Text="Open a Dune save or game executable to inspect its palaces, villages, forts, and sietches."
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         LineHeight="21"
                         Foreground="{StaticResource BodyBrush}" />
              <Button Classes="action"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Center"
                      Content="Open Dune file"
                      Command="{Binding OpenCommand}" />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding IsBusy}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="16"
                  Padding="14,10"
                  CornerRadius="3"
                  Background="#E6241B13">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ProgressBar Width="58" IsIndeterminate="True" />
              <TextBlock Text="Working…" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              IsVisible="{Binding HasSelection}"
              Width="356"
              Background="{StaticResource UmberBrush}"
              BorderBrush="{StaticResource HairlineBrush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="24,20"
                  Background="#332519"
                  BorderBrush="{StaticResource HairlineBrush}"
                  BorderThickness="0,0,0,1">
            <StackPanel>
              <TextBlock Text="{Binding SelectedLocation.Type}"
                         Classes="section-title" />
              <TextBlock Text="{Binding SelectedLocation.Name}"
                         Margin="0,5,0,0"
                         FontSize="21"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource WaterBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,20,24,30">
              <TextBlock Text="RESOURCES" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding SelectedLocation.Resources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NumericFieldViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                      <TextBlock Text="{Binding Label}"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource BodyBrush}" />
                      <NumericUpDown Grid.Column="1"
                                     Minimum="0"
                                     Maximum="255"
                                     Increment="1"
                                     FormatString="0"
                                     Value="{Binding Value, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Margin="0,18" Background="{StaticResource HairlineBrush}" />
              <TextBlock Text="CONDITIONS" Classes="section-title" />
              <ItemsControl Margin="0,5,0,0"
                            ItemsSource="{Binding SelectedLocation.Conditions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BooleanFieldViewModel">
                    <CheckBox Margin="0,4"
                              Content="{Binding Label}"
                              IsChecked="{Binding Value, Mode=TwoWay}"
                              Foreground="{StaticResource BodyBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Expander Classes="detail-group" Header="Advanced fields">
                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding SelectedLocation.Advanced}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumericFieldViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BodyBrush}" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="255"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>

              <Expander Classes="detail-group" Header="Unknown fields">
                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding SelectedLocation.Unknown}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumericFieldViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="255"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="18,7"
            Background="#20170F"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1"
                   Text="0–255 values · save writes in place"
                   FontSize="11"
                   Foreground="#7E6D5B" />
      </Grid>
    </Border>
  </Grid>
</Window>
