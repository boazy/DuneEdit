<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DuneEdit.Desktop.ViewModels"
        xmlns:views="using:DuneEdit.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="DuneEdit.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        Icon="/Assets/Locations/Sietch.4xbrz.png"
        Title="Dune Editor">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <vm:TroopOccupationDisplayConverter x:Key="TroopOccupationDisplayConverter" />
    <LinearGradientBrush x:Key="ArrakisSandFieldBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FFE681" />
      <GradientStop Offset="0.48" Color="#F1C452" />
      <GradientStop Offset="1" Color="#C67A2A" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ErgShadowBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#7D3616" />
      <GradientStop Offset="1" Color="#A84E1B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DuneCrestBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="#FFEFA7" />
      <GradientStop Offset="1" Color="#F4C750" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MapLabelBrush" Color="#703718" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.marker">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.marker:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sidebar-close">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.sidebar-close:pointerover">
      <Setter Property="Background" Value="#4A3B2B" />
      <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style Selector="Image.marker-icon.selected">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="7"
                          OffsetX="1"
                          OffsetY="3"
                          Color="#351A0A"
                          Opacity="0.55" />
      </Setter>
    </Style>
    <Style Selector="Image.troop-icon.selected">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="5"
                          OffsetX="0"
                          OffsetY="2"
                          Color="#FFF0AA"
                          Opacity="0.8" />
      </Setter>
    </Style>
    <Style Selector="TextBlock.location-name">
      <Setter Property="Foreground" Value="{StaticResource WaterBrush}" />
    </Style>
    <Style Selector="TextBlock.location-name.atreides">
      <Setter Property="Foreground" Value="{StaticResource AtreidesBrush}" />
    </Style>
    <Style Selector="TextBlock.location-name.desert">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.map-filter">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.map-filter:pointerover">
      <Setter Property="Background" Value="#4A3B2B" />
      <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
    </Style>
    <Style Selector="Button.map-filter.selected">
      <Setter Property="Background" Value="#765126" />
      <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
      <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style Selector="Button.terrain-toggle">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="#E6241B13" />
      <Setter Property="BorderBrush" Value="#8F6941" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style Selector="Button.terrain-toggle.enabled">
      <Setter Property="Background" Value="#765126" />
      <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style Selector="Button.terrain-toggle:pointerover">
      <Setter Property="Background" Value="#4A3B2B" />
      <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style Selector="Button.zoom-adjust">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    </Style>
    <Style Selector="Button.zoom-adjust:pointerover, Button.zoom-display:pointerover">
      <Setter Property="Background" Value="#4A3B2B" />
    </Style>
    <Style Selector="Button.zoom-display">
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Expander.detail-group">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="22,15"
            Background="#241B13"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DUNE EDITOR"
                     FontSize="22"
                     FontWeight="Black"
                     LetterSpacing="2.6"
                     Foreground="{StaticResource GoldBrush}" />
          <TextBlock Text="Save-game cartography"
                     Margin="0,2,0,0"
                     FontSize="11"
                     LetterSpacing="0.8"
                     Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Grid Grid.Column="1"
              Margin="28,0,0,0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="18">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentFileName}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BodyBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusText}"
                       Margin="0,3,0,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="6">
            <Border Padding="4"
                    CornerRadius="3"
                    Background="#E6241B13"
                    BorderBrush="#8F6941"
                    BorderThickness="1">
              <StackPanel Orientation="Horizontal"
                          Spacing="2"
                          IsEnabled="{Binding HasDocument}">
                <Button Classes="map-filter"
                        Classes.selected="{Binding IsNoMapFilter}"
                        Content="NONE"
                        Command="{Binding SelectNoMapFilterCommand}"
                        ToolTip.Tip="Show the unfiltered Arrakis map" />
                <Button Classes="map-filter"
                        Classes.selected="{Binding IsAreaControlFilter}"
                        Content="CONTROL"
                        Command="{Binding SelectAreaControlFilterCommand}"
                        ToolTip.Tip="Atreides red · Harkonnen blue · uncontrolled desert" />
                <Button Classes="map-filter"
                        Classes.selected="{Binding IsSpiceDensityFilter}"
                        Content="SPICE"
                        Command="{Binding SelectSpiceDensityFilterCommand}"
                        ToolTip.Tip="Brighter gold marks denser spice fields" />
                <Button Classes="map-filter"
                        Classes.selected="{Binding IsDiscoveryFilter}"
                        Content="DISCOVERY"
                        Command="{Binding SelectDiscoveryFilterCommand}"
                        ToolTip.Tip="Masks undiscovered zones and locations" />
              </StackPanel>
            </Border>
            <Button Classes="terrain-toggle"
                    Classes.enabled="{Binding IsTerrainEnabled}"
                    Classes.transparent="{Binding IsTerrainVisibleThroughFilter}"
                    Command="{Binding CycleTerrainModeCommand}"
                    ToolTip.Tip="{Binding TerrainToggleToolTip}">
              <Canvas Width="18" Height="16">
                <Path IsVisible="{Binding IsTerrainEnabled}"
                      Data="M 1,14 L 7,6 L 10,10 L 13,3 L 17,14 Z"
                      Fill="{StaticResource GoldBrush}" />
                <Path IsVisible="{Binding IsTerrainEnabled}"
                      Data="M 5,14 L 9,9 L 11,11 L 13,8 L 16,14 Z"
                      Fill="#241B13"
                      Opacity="0.45" />
                <Path IsVisible="{Binding IsTerrainVisibleThroughFilter}"
                      Data="M 1,14 L 7,6 L 10,10 L 13,3 L 17,14 Z"
                      Fill="Transparent"
                      Stroke="{StaticResource GoldBrush}"
                      StrokeDashArray="1,1"
                      StrokeLineCap="Round"
                      StrokeThickness="1.5" />
                <Path IsVisible="{Binding IsTerrainDisabled}"
                      Data="M 1,14 L 7,6 L 10,10 L 13,3 L 17,14 Z"
                      Fill="{StaticResource MutedBrush}" />
              </Canvas>
            </Button>
            <Button Classes="terrain-toggle"
                    Classes.enabled="{Binding IsTroopDisplayEnabled}"
                    Command="{Binding ToggleTroopDisplayCommand}"
                    ToolTip.Tip="{Binding TroopDisplayToolTip}">
              <Canvas Width="18" Height="16">
                <Image Source="/Assets/FremenFilled.4xbrz.png"
                       Width="15"
                       Height="15"
                       Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="None" />
                <Path IsVisible="{Binding !IsTroopDisplayEnabled}"
                      Data="M 2,2 L 16,14"
                      Stroke="{StaticResource MutedBrush}"
                      StrokeThickness="2" />
              </Canvas>
            </Button>
          </StackPanel>
        </Grid>

        <Button Grid.Column="2"
                Classes="action"
                Content="Open file"
                Command="{Binding OpenCommand}" />
        <Button Grid.Column="3"
                Classes="action"
                Content="Save changes"
                Command="{Binding SaveCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Border Margin="18"
              CornerRadius="5"
              ClipToBounds="True"
              BorderBrush="#6C5130"
              BorderThickness="1"
              Background="{StaticResource ArrakisSandFieldBrush}">

        <Grid x:Name="MapViewport"
              Cursor="SizeAll">
          <Grid.GestureRecognizers>
            <PinchGestureRecognizer />
            <ScrollGestureRecognizer CanHorizontallyScroll="True"
                                     CanVerticallyScroll="True"
                                     IsScrollInertiaEnabled="True" />
          </Grid.GestureRecognizers>
          <Canvas x:Name="MapSurface"
                  Width="5000"
                  Height="620"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  RenderTransformOrigin="0,0">
            <views:MapTile Canvas.Left="0" />
            <views:MapTile Canvas.Left="1000" />
            <views:MapTile Canvas.Left="2000" />
            <views:MapTile Canvas.Left="3000" />
            <views:MapTile Canvas.Left="4000" />
          </Canvas>

          <Border HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="14"
                  Padding="6,4"
                  CornerRadius="99"
                  Background="#D9241B13"
                  BorderBrush="#8F6941"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="zoom-adjust"
                      Content="−"
                      Click="ZoomOutClicked"
                      ToolTip.Tip="Zoom out" />
              <Button Classes="zoom-display"
                      ToolTip.Tip="Choose map zoom">
                <TextBlock x:Name="MapZoomText"
                           Text="100%"
                           FontSize="12"
                           FontWeight="Bold"
                           LetterSpacing="0.5"
                           Foreground="{StaticResource GoldBrush}" />
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <UniformGrid Columns="4" Margin="4">
                      <Button Content="100%" Tag="1" Click="MapZoomPresetClicked" />
                      <Button Content="125%" Tag="1.25" Click="MapZoomPresetClicked" />
                      <Button Content="150%" Tag="1.5" Click="MapZoomPresetClicked" />
                      <Button Content="175%" Tag="1.75" Click="MapZoomPresetClicked" />
                      <Button Content="200%" Tag="2" Click="MapZoomPresetClicked" />
                      <Button Content="225%" Tag="2.25" Click="MapZoomPresetClicked" />
                      <Button Content="250%" Tag="2.5" Click="MapZoomPresetClicked" />
                      <Button Content="275%" Tag="2.75" Click="MapZoomPresetClicked" />
                      <Button Content="300%" Tag="3" Click="MapZoomPresetClicked" />
                      <Button Content="325%" Tag="3.25" Click="MapZoomPresetClicked" />
                      <Button Content="350%" Tag="3.5" Click="MapZoomPresetClicked" />
                      <Button Content="375%" Tag="3.75" Click="MapZoomPresetClicked" />
                      <Button Content="400%" Tag="4" Click="MapZoomPresetClicked" />
                    </UniformGrid>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Classes="zoom-adjust"
                      Content="+"
                      Click="ZoomInClicked"
                      ToolTip.Tip="Zoom in" />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding HasNoDocument}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="32,26"
                  CornerRadius="4"
                  Background="#DB201A15"
                  BorderBrush="#8F6941"
                  BorderThickness="1">
            <StackPanel MaxWidth="340" Spacing="8">
              <TextBlock Text="Chart a saved Arrakis"
                         HorizontalAlignment="Center"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource GoldBrush}" />
              <TextBlock Text="Open a Dune save or game executable to inspect its palaces, villages, forts, and sietches."
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         LineHeight="21"
                         Foreground="{StaticResource BodyBrush}" />
              <Button Classes="action"
                      Margin="0,10,0,0"
                      HorizontalAlignment="Center"
                      Content="Open Dune file"
                      Command="{Binding OpenCommand}" />
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding IsBusy}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="16"
                  Padding="14,10"
                  CornerRadius="3"
                  Background="#E6241B13">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ProgressBar Width="58" IsIndeterminate="True" />
              <TextBlock Text="Working…" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              IsVisible="{Binding HasSelection}"
              Width="356"
              Background="{StaticResource UmberBrush}"
              BorderBrush="{StaticResource HairlineBrush}"
              BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="24,20"
                  Background="#332519"
                  BorderBrush="{StaticResource HairlineBrush}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding SelectedType}"
                           Classes="section-title" />
                <TextBlock Text="{Binding SelectedName}"
                           Classes="location-name"
                           Classes.atreides="{Binding IsSelectionAtreides}"
                           Classes.desert="{Binding IsSelectionDesert}"
                           Margin="0,5,0,0"
                           FontSize="21"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="sidebar-close"
                      Content="×"
                      Command="{Binding CloseSelectionCommand}"
                      ToolTip.Tip="Close location details" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1">
            <StackPanel>
            <StackPanel Margin="24,20,24,30"
                        IsVisible="{Binding HasLocationSelection}">
              <TextBlock Text="RESOURCES" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding SelectedLocation.Resources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NumericFieldViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                      <TextBlock Text="{Binding Label}"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource BodyBrush}" />
                      <NumericUpDown Grid.Column="1"
                                     Minimum="0"
                                     Maximum="255"
                                     Increment="1"
                                     FormatString="0"
                                     Value="{Binding Value, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Margin="0,18" Background="{StaticResource HairlineBrush}" />
              <TextBlock Text="CONDITIONS" Classes="section-title" />
              <ItemsControl Margin="0,5,0,0"
                            ItemsSource="{Binding SelectedLocation.Conditions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BooleanFieldViewModel">
                    <CheckBox Margin="0,4"
                              Content="{Binding Label}"
                              IsChecked="{Binding Value, Mode=TwoWay}"
                              Foreground="{StaticResource BodyBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Expander Classes="detail-group" Header="Advanced fields">
                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding SelectedLocation.Advanced}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumericFieldViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BodyBrush}" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="255"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>

              <Expander Classes="detail-group" Header="Unknown fields">
                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding SelectedLocation.Unknown}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumericFieldViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" />
                        <NumericUpDown Grid.Column="1"
                                       Minimum="0"
                                       Maximum="255"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Value, Mode=TwoWay}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
            <StackPanel Margin="24,20,24,30"
                        IsVisible="{Binding HasFremenTroopSelection}">
              <TextBlock Text="OCCUPATION" Classes="section-title" />
              <TextBlock IsVisible="{Binding SelectedFremenTroop.HasCurrentGameState}"
                         Text="{Binding SelectedFremenTroop.CurrentGameState}"
                         Margin="0,5,0,0"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}" />
              <ComboBox Margin="0,7,0,0"
                        ItemsSource="{Binding SelectedFremenTroop.AvailableOccupations}"
                        SelectedItem="{Binding SelectedFremenTroop.SelectedOccupation, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource TroopOccupationDisplayConverter}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Text="Job"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BodyBrush}" />
                <ComboBox Grid.Column="1"
                          MinWidth="170"
                          IsEnabled="{Binding SelectedFremenTroop.IsJobEnabled}"
                          ItemsSource="{Binding SelectedFremenTroop.AvailableJobs}"
                          SelectedItem="{Binding SelectedFremenTroop.SelectedJob, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource TroopOccupationDisplayConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                <TextBlock Text="Allegiance"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BodyBrush}" />
                <ComboBox Grid.Column="1"
                          MinWidth="170"
                          IsEnabled="{Binding SelectedFremenTroop.IsAllegianceEnabled}"
                          ItemsSource="{Binding SelectedFremenTroop.AvailableAllegiances}"
                          SelectedItem="{Binding SelectedFremenTroop.SelectedAllegiance, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource TroopOccupationDisplayConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <CheckBox Margin="0,8,0,0"
                        IsEnabled="{Binding SelectedFremenTroop.IsJobCompletedEnabled}"
                        Content="Job completed"
                        IsChecked="{Binding SelectedFremenTroop.JobCompleted, Mode=TwoWay}"
                        Foreground="{StaticResource BodyBrush}" />

              <Border Height="1" Margin="0,18" Background="{StaticResource HairlineBrush}" />
              <TextBlock Text="ABILITY" Classes="section-title" />
              <ItemsControl ItemsSource="{Binding SelectedFremenTroop.Attributes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NumericFieldViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                      <TextBlock Text="{Binding Label}"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource BodyBrush}" />
                      <NumericUpDown Grid.Column="1"
                                     Minimum="0"
                                     Maximum="255"
                                     Increment="1"
                                     FormatString="0"
                                     Value="{Binding Value, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                <TextBlock Text="{Binding SelectedFremenTroop.People.Label}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BodyBrush}" />
                <NumericUpDown Grid.Column="1"
                               Minimum="0"
                               Maximum="{Binding SelectedFremenTroop.People.Maximum}"
                               Increment="{Binding SelectedFremenTroop.People.Increment}"
                               FormatString="0"
                               Value="{Binding SelectedFremenTroop.People.Value, Mode=TwoWay}" />
              </Grid>

              <Border Height="1" Margin="0,18" Background="{StaticResource HairlineBrush}" />
              <TextBlock Text="EQUIPMENT" Classes="section-title" />
              <ItemsControl Margin="0,5,0,0"
                            ItemsSource="{Binding SelectedFremenTroop.Equipment}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BooleanFieldViewModel">
                    <CheckBox Margin="0,4"
                              Content="{Binding Label}"
                              IsChecked="{Binding Value, Mode=TwoWay}"
                              Foreground="{StaticResource BodyBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="18,7"
            Background="#20170F"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1"
                   Text="0–255 values · save writes in place"
                   FontSize="11"
                   Foreground="#7E6D5B" />
      </Grid>
    </Border>
  </Grid>
</Window>
