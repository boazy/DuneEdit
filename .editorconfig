root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

# Run every SDK analyzer and every installed third-party analyzer during builds.
dotnet_analyzer_diagnostic.severity = warning
# Keep high-signal engineering categories visible. Optional API surface,
# localization, documentation, and cosmetic style advice stays in the IDE.
dotnet_analyzer_diagnostic.category-Maintainability.severity = warning
dotnet_analyzer_diagnostic.category-Naming.severity = warning
dotnet_analyzer_diagnostic.category-Performance.severity = warning
dotnet_analyzer_diagnostic.category-Design.severity = suggestion
dotnet_analyzer_diagnostic.category-Documentation.severity = suggestion
dotnet_analyzer_diagnostic.category-Globalization.severity = suggestion
dotnet_analyzer_diagnostic.category-Style.severity = suggestion

# Correctness diagnostics are build-breaking. Maintainability findings remain
# warnings so existing debt can be reviewed and adopted deliberately.
dotnet_analyzer_diagnostic.category-Reliability.severity = error
dotnet_analyzer_diagnostic.category-Security.severity = error
dotnet_analyzer_diagnostic.category-Usage.severity = error

# Complexity limits. Sonar S3776 independently enforces cognitive complexity.
dotnet_diagnostic.CA1502.severity = warning
dotnet_code_quality.CA1502.threshold = 15
dotnet_diagnostic.CA1505.severity = warning
dotnet_code_quality.CA1505.threshold = 20
dotnet_diagnostic.CA1506.severity = warning
dotnet_code_quality.CA1506.threshold = 15
dotnet_diagnostic.S138.severity = warning
dotnet_diagnostic.S3776.severity = warning

# Declarative collection processing and LINQ simplification.
dotnet_diagnostic.S3267.severity = warning
dotnet_diagnostic.S2971.severity = warning

# Immutability and value-type correctness.
dotnet_style_readonly_field = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.CA1815.severity = warning

# Language and expression preferences.
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_prefer_collection_expression = true:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_simple_using_statement = true:warning
csharp_prefer_braces = true:error

dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:warning
dotnet_style_prefer_conditional_expression_over_return = true:warning

# Naming: one vocabulary and casing convention per symbol kind.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_use_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_use_i_prefix.style = prefixed_pascal_case
dotnet_naming_rule.interfaces_use_i_prefix.severity = warning

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_rule.types_use_pascal_case.symbols = types
dotnet_naming_rule.types_use_pascal_case.style = pascal_case
dotnet_naming_rule.types_use_pascal_case.severity = warning

dotnet_naming_symbols.non_private_members.applicable_kinds = property, method, event
dotnet_naming_symbols.non_private_members.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.non_private_members_use_pascal_case.symbols = non_private_members
dotnet_naming_rule.non_private_members_use_pascal_case.style = pascal_case
dotnet_naming_rule.non_private_members_use_pascal_case.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_use_pascal_case.symbols = constants
dotnet_naming_rule.constants_use_pascal_case.style = pascal_case
dotnet_naming_rule.constants_use_pascal_case.severity = warning

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_rule.private_static_fields_use_pascal_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_use_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_fields_use_pascal_case.severity = warning

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_rule.private_instance_fields_use_camel_case.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_use_camel_case.style = camel_case
dotnet_naming_rule.private_instance_fields_use_camel_case.severity = warning

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_symbols.parameters_and_locals.applicable_accessibilities = *
dotnet_naming_rule.parameters_and_locals_use_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_use_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_use_camel_case.severity = warning

dotnet_naming_style.prefixed_pascal_case.required_prefix = I
dotnet_naming_style.prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

# Generated MVVM and Avalonia artifacts are analyzed by their generators, not by
# source naming/style policy.
[**/obj/**/*.cs]
generated_code = true

[*.axaml]
indent_style = space
indent_size = 2
